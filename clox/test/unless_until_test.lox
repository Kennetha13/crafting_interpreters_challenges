// unless: runs its body only when the condition is falsey.
print("TEST 1 START");
unless (false) {
  print "ran because false is falsey";
}
unless (true) {
  print "should not print";
} else {
  print "else ran because true is truthy";
}
print("TEST 1 END");

print "";

// until: loops while the condition is falsey, i.e. "until" it becomes true.
print("TEST 2 START");
var i = 0;
until (i == 3) {
  print i;
  i = i + 1;
}
print("TEST 2 END");

print "";

// until whilst also using continue
print("TEST 3 START");
var j = 0;
until (j == 5) {
  j = j + 1;
  if (j == 3) continue;
  print j;
}
print("TEST 3 END");
